    subgraph TelemetryPlane["3. Dual-Path Telemetry Engine (Go / Cloud Run)"]
        Filter -->|POST /telemetry/record| Interceptor["telemetry-interceptor (Go)<br/>Sub-ms Ingress Buffer"]
        Interceptor --> HotPath["HOT PATH (<0.5ms RAM)<br/>15s Sliding Window<br/>ΔRPS & P95 Latency Slope"]
        Interceptor -->|Async Batch| ColdPath["COLD PATH (Cloud Pub/Sub)<br/>Streaming Ingestion"]
        ColdPath --> BigQuery[("BigQuery Analytical Store<br/>pulseguard_telemetry.telemetry_events")]
    end

    subgraph AgentCore["4. Agentic Reasoning Core (Vertex AI)"]
